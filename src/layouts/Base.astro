---
import '@/styles/global.css';
interface Props { title: string; description?: string; ogImage?: string; canonical?: string; wide?: boolean; jsonLd?: unknown }
const { title, description = 'What is being built in Hamlin and Horizon West, Winter Garden FL: permits, construction, openings, and what each business will offer.', ogImage, wide = false, jsonLd } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = Astro.props.canonical ?? `${site}${Astro.url.pathname}`;
const NAV = [
  { href: '/', label: 'Home', icon: 'M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { href: '/explore', label: 'Explore', icon: 'M4 6h16M4 12h16M4 18h10' },
  { href: '/map', label: 'Map', icon: 'M9 18l-6 3V6l6-3 6 3 6-3v15l-6 3-6-3zM9 3v15M15 6v15' },
  { href: '/timeline', label: 'Timeline', icon: 'M12 3v18M5 8h4M15 14h4M5 8a2 2 0 1 0 4 0 2 2 0 0 0-4 0zM15 14a2 2 0 1 0 4 0 2 2 0 0 0-4 0z' },
  { href: '/more', label: 'More', icon: 'M5 12h.01M12 12h.01M19 12h.01' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Hamlin Development Tracker</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Hamlin Development Tracker" href="/feed.xml" />
    <link rel="alternate" type="application/feed+json" title="Hamlin Development Tracker" href="/feed.json" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1216" media="(prefers-color-scheme: dark)" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="container top-inner">
        <a class="brand" href="/" aria-label="Hamlin Development Tracker home">
          <span class="brand-mark" aria-hidden="true">H</span>
          <span class="brand-text">Hamlin <span>Tracker</span></span>
        </a>
        <nav class="desktop-nav" aria-label="Primary">
          {NAV.filter((n) => n.href !== '/more').map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a href="/coming-soon" aria-current={isActive('/coming-soon') ? 'page' : undefined}>Coming soon</a>
          <a href="/whats-new" aria-current={isActive('/whats-new') ? 'page' : undefined}>What's new</a>
          <a href="/stats" aria-current={isActive('/stats') ? 'page' : undefined}>Stats</a>
          <a href="/how-permits-work" aria-current={isActive('/how-permits-work') ? 'page' : undefined}>How permits work</a>
          <a class="btn btn-primary" href="/subscribe">Subscribe</a>
        </nav>
      </div>
    </header>
    <main id="main" class={wide ? '' : 'container'}>
      <slot />
    </main>
    <footer class="foot container">
      <p class="small muted">Community-run tracker for Hamlin &amp; Horizon West, Winter Garden, FL. Not affiliated with Orange County, the City of Winter Garden, or any developer. Data is gathered automatically from public permit records and local news; always confirm with the <a href="/how-permits-work">official sources</a>. Spot an error? <a href="https://github.com/tpcasco/hamlin-permits-dashboard/issues/new?template=data-correction.md" rel="noopener">Report it</a>.</p>
    </footer>
    <nav class="tabbar" aria-label="Primary mobile">
      {NAV.map((n) => (
        <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={n.icon} /></svg>
          <span>{n.label}</span>
        </a>
      ))}
    </nav>
  </body>
</html>
<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--accent); color: #fff; padding: 8px 12px; border-radius: 8px; z-index: 1000; }
  .skip:focus { left: 8px; }
  .top { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter: saturate(180%) blur(12px); border-bottom: 1px solid var(--border); }
  .top-inner { height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text); font-weight: 800; letter-spacing: -.01em; text-decoration: none; }
  .brand-mark { width: 32px; height: 32px; border-radius: 9px; background: linear-gradient(135deg, var(--accent), #7c3aed); color: #fff; display: grid; place-items: center; font-weight: 900; }
  .brand-text span { color: var(--accent-text); }
  .desktop-nav { display: none; align-items: center; gap: 4px; }
  .desktop-nav a:not(.btn) { padding: 8px 12px; border-radius: 8px; color: var(--text-2); font-weight: 600; font-size: .92rem; }
  .desktop-nav a:not(.btn):hover, .desktop-nav a[aria-current="page"]:not(.btn) { background: var(--surface-2); color: var(--text); text-decoration: none; }
  .desktop-nav .btn { margin-left: 8px; }
  .foot { padding: 32px var(--gutter) 40px; }
  .tabbar { position: fixed; bottom: 0; left: 0; right: 0; height: calc(var(--tab-h) + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: saturate(180%) blur(12px); border-top: 1px solid var(--border); display: grid; grid-template-columns: repeat(5, 1fr); z-index: 60; }
  .tabbar a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; font-size: .68rem; font-weight: 600; color: var(--text-3); text-decoration: none; }
  .tabbar a[aria-current="page"] { color: var(--accent-text); }
  @media (min-width: 900px) { .desktop-nav { display: flex; } .tabbar { display: none; } }
</style>
